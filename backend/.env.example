# ─── Application ────────────────────────────────────────────────────────────
APP_ENV=development          # development | production
APP_HOST=0.0.0.0
APP_PORT=8000
UPLOADS_DIR=../uploads       # relative to backend/ or absolute path

# ─── MongoDB ─────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=AI_Enhanced_Service

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Alerts: Telegram (free — create bot via @BotFather) ────────────────────
# TELEGRAM_BOT_TOKEN=123456789:ABCDefgh...
# Default chat_id for system-level alerts (optional)
# TELEGRAM_DEFAULT_CHAT_ID=

# ─── Alerts: Gmail SMTP (free — use an App Password, not your real password) ─
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=yourname@gmail.com
# SMTP_PASSWORD=your-app-password-here

# ─── Alerts: ntfy.sh (free — no account needed) ─────────────────────────────
# NTFY_BASE_URL=https://ntfy.sh
# NTFY_DEFAULT_TOPIC=ai-surveillance-alerts
